---
/**
 * Client-side Mermaid renderer.
 * Supports:
 * - <script type="text/plain" class="mermaid-source">…</script> (Astro-safe)
 * - Markdown ```mermaid fences (incl. Shiki wrappers)
 * - legacy <pre class="mermaid">
 */
---

<script>
	function collectMermaidSources(): { node: Element; source: string }[] {
		const found: { node: Element; source: string }[] = [];

		document.querySelectorAll('script.mermaid-source[type="text/plain"]').forEach((el) => {
			if ((el as HTMLElement).dataset.mermaidRendered === 'true') return;
			found.push({ node: el, source: el.textContent ?? '' });
		});

		document.querySelectorAll('pre.mermaid').forEach((el) => {
			if ((el as HTMLElement).dataset.mermaidRendered === 'true') return;
			found.push({ node: el, source: el.textContent ?? '' });
		});

		document
			.querySelectorAll(
				'pre > code.language-mermaid, pre > code.mermaid, code[data-language="mermaid"]',
			)
			.forEach((el) => {
				const pre = el.closest('pre') ?? el;
				if ((pre as HTMLElement).dataset.mermaidRendered === 'true') return;
				found.push({ node: pre, source: el.textContent ?? '' });
			});

		// Shiki / Astro often use class lists like "astro-code language-mermaid"
		document.querySelectorAll('pre.astro-code').forEach((pre) => {
			if ((pre as HTMLElement).dataset.mermaidRendered === 'true') return;
			const cls = pre.className || '';
			const code = pre.querySelector('code');
			const lang =
				pre.getAttribute('data-language') ||
				code?.getAttribute('data-language') ||
				code?.className ||
				cls;
			if (!/mermaid/i.test(String(lang))) return;
			found.push({ node: pre, source: code?.textContent ?? pre.textContent ?? '' });
		});

		return found.filter((item) => item.source.trim().length > 0);
	}

	async function renderMermaid() {
		const blocks = collectMermaidSources();
		if (!blocks.length) return;

		const mermaid = (await import('mermaid')).default;

		mermaid.initialize({
			startOnLoad: false,
			theme: 'base',
			securityLevel: 'loose',
			fontFamily: 'IBM Plex Sans, system-ui, sans-serif',
			themeVariables: {
				primaryColor: '#d8efe8',
				primaryTextColor: '#1a2332',
				primaryBorderColor: '#0e7c66',
				lineColor: '#4a5a6a',
				secondaryColor: '#e8eef0',
				tertiaryColor: '#f3f6f4',
				background: '#ffffff',
				mainBkg: '#d8efe8',
				nodeBorder: '#0e7c66',
				clusterBkg: '#f3f6f4',
				titleColor: '#1a2332',
				edgeLabelBackground: '#ffffff',
			},
		});

		const targets: HTMLElement[] = [];

		blocks.forEach((item, i) => {
			const host = item.node as HTMLElement;
			if (host.dataset.mermaidRendered === 'true') return;

			const container = document.createElement('div');
			container.className = 'mermaid';
			container.id = `mermaid-${i}-${Date.now()}`;
			container.textContent = item.source.trim();
			host.replaceWith(container);
			container.dataset.mermaidRendered = 'true';
			targets.push(container);
		});

		if (targets.length) {
			await mermaid.run({ nodes: targets });
		}
	}

	renderMermaid();
	document.addEventListener('astro:page-load', renderMermaid);
</script>
