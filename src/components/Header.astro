---
import { SITE_TITLE, GITHUB_REPO } from '../consts';
import { withBase } from '../utils/url';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a class="brand" href={withBase()}>
			<span class="brand-mark" aria-hidden="true">μ</span>
			<span class="brand-name">{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href={withBase()}>Home</HeaderLink>
			<HeaderLink href={withBase('blog')}>Posts</HeaderLink>
			<HeaderLink href={withBase('paths')}>Paths</HeaderLink>
			<HeaderLink href={withBase('about')}>About</HeaderLink>
		</div>
		<a class="github" href={GITHUB_REPO} target="_blank" rel="noopener noreferrer">
			<span class="sr-only">GitHub repository</span>
			<svg viewBox="0 0 16 16" aria-hidden="true" width="22" height="22">
				<path
					fill="currentColor"
					d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
				></path>
			</svg>
		</a>
	</nav>
	<div class="nav-line" aria-hidden="true"></div>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 40;
		backdrop-filter: blur(10px);
		background: rgba(243, 246, 244, 0.88);
		border-bottom: 1px solid var(--line);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--max-wide);
		margin: 0 auto;
		padding: 0.85rem 1.25rem;
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		text-decoration: none;
		color: var(--ink);
	}
	.brand-mark {
		display: grid;
		place-items: center;
		width: 1.75rem;
		height: 1.75rem;
		background: linear-gradient(135deg, var(--accent), var(--accent-2));
		color: #fff;
		font-family: var(--font-mono), monospace;
		font-weight: 600;
		font-size: 1rem;
		border-radius: 3px;
		transition: transform 0.25s ease;
	}
	.brand:hover .brand-mark {
		transform: rotate(-8deg) scale(1.05);
	}
	.brand-name {
		font-family: var(--font-display), Georgia, serif;
		font-weight: 700;
		font-size: 1.2rem;
		letter-spacing: -0.03em;
	}
	.internal-links {
		display: flex;
		gap: 0.15rem;
	}
	.internal-links :global(a) {
		padding: 0.4rem 0.7rem;
		color: var(--ink-muted);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 500;
		border-radius: 3px;
		transition:
			color 0.2s ease,
			background 0.2s ease;
	}
	.internal-links :global(a:hover),
	.internal-links :global(a.active) {
		color: var(--accent-deep);
		background: var(--accent-soft);
	}
	.github {
		color: var(--ink-muted);
		display: flex;
		padding: 0.35rem;
		transition: color 0.2s ease;
	}
	.github:hover {
		color: var(--ink);
	}
	.nav-line {
		height: 2px;
		background: linear-gradient(90deg, transparent, var(--accent), transparent);
		transform-origin: left;
		animation: draw-line 1s ease 0.4s both;
	}
	@media (max-width: 640px) {
		.internal-links {
			display: none;
		}
	}
</style>
