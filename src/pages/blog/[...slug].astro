---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import { sortByCurriculum } from '../../utils/curriculum';

export async function getStaticPaths() {
	const posts = sortByCurriculum(await getCollection('blog'));
	return posts.map((post, i) => {
		const prev = i > 0 ? posts[i - 1] : null;
		const next = i < posts.length - 1 ? posts[i + 1] : null;
		return {
			params: { slug: post.id },
			props: {
				post,
				prev: prev ? { id: prev.id, title: prev.data.title } : null,
				next: next ? { id: next.id, title: next.data.title } : null,
			},
		};
	});
}

type Props = {
	post: CollectionEntry<'blog'>;
	prev: { id: string; title: string } | null;
	next: { id: string; title: string } | null;
};

const { post, prev, next } = Astro.props;
const { Content } = await render(post);
---

<BlogPost {...post.data} prev={prev} next={next}>
	<Content />
</BlogPost>
